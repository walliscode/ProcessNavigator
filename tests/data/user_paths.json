[
  {
    "path": ["home_get"],
    "follow_redirects": false,
    "assertions": {
      "status_code": 302,
      "content": [],
      "session": {}
    }
  },
  {
    "path": ["register_get"],
    "follow_redirects": false,
    "assertions": {
      "status_code": 200,
      "content": [],
      "session": {}
    }
  },
  {
    "path": ["register_user"],
    "follow_redirects": false,
    "assertions": {
      "status_code": 200,
      "content": [
        "User test user was registered successfully with email test_user@astrea-bio.com"
      ],
      "session": {}
    }
  },
  {
    "path": ["login_get"],
    "follow_redirects": false,
    "assertions": {
      "status_code": 200,
      "content": ["Email", "Password", "Login"],
      "session": {}
    }
  },
  {
    "path": ["login_user"],
    "follow_redirects": false,
    "assertions": {
      "status_code": 200,
      "content": ["User with email test_user@astrea-bio.com does not exist."],
      "session": {}
    }
  },
  {
    "path": ["register_user", "login_get", "login_user"],
    "follow_redirects": false,
    "assertions": {
      "status_code": 302,
      "location": "/",
      "content": [],
      "session": {}
    }
  },
  {
    "path": ["register_user", "login_get", "login_user_bad_password"],
    "follow_redirects": false,
    "assertions": {
      "status_code": 200,
      "content": ["Incorrect password for user test_user@astrea-bio.com."]
    }
  },
  {
    "path": ["data_index_get"],
    "follow_redirects": false,
    "assertions": {
      "status_code": 302,
      "location": "/login"
    }
  },
  {
    "path": ["register_user", "login_user", "data_index_get"],
    "follow_redirects": false,
    "assertions": {
      "status_code": 200,
      "content": [
        "Click on the links below to take you to the relevant page",
        "<a href=\"/data/process_methods\">Process Methods</a>"
      ]
    }
  },

  {
    "path": [
      "register_user",
      "login_user",
      "data_index_get",
      "process_method_get"
    ],
    "description": "User navigates to the process method page via the data index page",
    "follow_redirects": false,
    "assertions": {
      "status_code": 200,
      "content": [
        "Process Methods",
        "Welcome to the Process Methods page",
        "Add Method",
        "Edit Method",
        "Delete Method"
      ]
    }
  },
  {
    "path": [
      "register_user",
      "login_user",
      "data_index_get",
      "process_method_get",
      "process_method_post_add_method"
    ],
    "description": "User starts 'add process method' process from method page",
    "follow_redirects": false,

    "assertions": {
      "status_code": 302,
      "location": "/data/add_process_method",
      "security_keys": ["add_process_method"]
    }
  },
  {
    "path": [
      "register_user",
      "login_user",
      "data_index_get",
      "process_method_get",
      "process_method_post_add_method",
      "add_process_method_get"
    ],
    "description": "User navigates to the add method page via the method page, this should be a valid route",
    "follow_redirects": false,
    "assertions": {
      "status_code": 200
    }
  },
  {
    "path": [
      "register_user",
      "login_user",
      "data_index_get",
      "delete_process_method_get"
    ],
    "description": "User navgiates to the delete process method page without going via tht e process method page, this should redirect to the process method page",
    "follow_redirects": false,
    "assertions": {
      "status_code": 302,
      "location": "/data/process_methods"
    }
  },
  {
    "path": [
      "register_user",
      "login_user",
      "data_index_get",
      "process_method_post_delete_method",
      "delete_process_method_get"
    ],
    "description": "User navigates to the delete process method page via the process method page, this should be a valid route",
    "follow_redirects": false,
    "assertions": {
      "status_code": 200
    }
  },
  {
    "path": [
      "register_user",
      "login_user",
      "data_index_get",
      "process_method_post_delete_method",
      "delete_process_method_get",
      "delete_process_method_post"
    ],
    "description": "User deletes a process method",
    "follow_redirects": true,
    "assertions": {
      "status_code": 200,
      "location": "/data/process_methods",
      "content": [
        "Process Method test_process_method_1 and Process Method Parts test_part_1, test_part_2, test_part_3 deleted from database"
      ]
    }
  },
  {
    "path": ["register_user", "login_user", "data_index_get", "units_get"],
    "description": "User navigates to the units page via the data index page",
    "follow_redirects": false,
    "assertions": {
      "status_code": 200,
      "content": [
        "Units",
        "Welcome to the Units page",
        "Add Unit",
        "Edit Unit",
        "Delete Unit"
      ]
    }
  },
  {
    "path": [
      "register_user",
      "login_user",
      "data_index_get",
      "analysis_methods_get"
    ],
    "description": "User navigates to the analysis methods page via the data index page",
    "follow_redirects": false,
    "assertions": {
      "status_code": 200,
      "content": [
        "Analysis Methods",
        "Welcome to the Analysis Methods page",
        "Add Analysis Method",
        "Edit Analysis Method",
        "Delete Analysis Method"
      ]
    }
  }
]
