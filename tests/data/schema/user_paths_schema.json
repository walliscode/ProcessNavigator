        "properties": {
          "status_code": {
            "type": "integer",
            "description": "The HTTP status code of the response"
          },
          "content": {
            "type": "array",
            "description": "The content of the response",
            "items": {
              "type": "string"
            }
          },
          "session": {
            "type": "object",
            "description": "The session variables set by the response"
          }
        }
      }
    }
  }
}
